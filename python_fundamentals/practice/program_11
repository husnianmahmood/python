class Student:
  def __init__(self, name:str, marks:int):
    self.name:str = name
    self.__marks:int = marks
  def getMarks(self):
    return self.__marks
  def setMarks(self, new_marks:int):
    if new_marks >= 0 and new_marks <= 100:
      self.__marks = new_marks
    else:
      print("Invalid marks!")


s1 = Student("husnain", 57)
print(s1.getMarks())
print(s1.name)
s1.setMarks(90)
print(s1.getMarks())
s1.setMarks(150)
print(s1.getMarks())


