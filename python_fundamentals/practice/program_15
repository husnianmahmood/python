class Person:
  def __init__(self, name: str, age:int):
    self.name: str = name
    self.age: int = age
  def show_details(self):
    print(f"{self.name}")
    print(f"{self.age}")
  def introduction(self):
    print(f"Hi, I am {self.name}")


class Student(Person):
  def __init__(self,name:str, age:int,  grade, marks:float, attendance:float):
    super().__init__(name, age)
    self.grade = grade
    self.__marksmarks = marks
    self.__attendance = attendance
  @property
  def marks(self):
    return self.__marks
  @marks.setter
  def marks(self, new_marks):
    if 0 <= new_marks >=100:
      self.__marks = new_marks
    else:
      print("Invalid Marks")
  @property
  def attendance(self):
    return self.__attendance
  @attendance.setter
  def attendace(self, new_attendance):
    if 0 <= new_attendace >= 100:
      self.__attendance = new_attendance
    else:
      print("Invalid Attendance")
  def study(self):
    print(f"{self.name} is studying Python.")
  def introduction(self):
    print(f"Hi, I am {self.name}")
    print(f"I am a student of grade {self.grade}")

class Teacher(Person):
  def __init__(self,name, age, subject: str, salary: int, experience: int):
    super().__init__(name, age)
    self.subject:str = subject
    self.salary:int = salary
    self.experience:int = experience

  def teach(self):
    print(f"{self.name} is teaching Python.")
  def check_assignment(self):
    print("Assignment checked successfully")
  def introduction(self):
    print(f"Hi, I am {self.name}")
    print(f"My subject is {self.subject}")
class Principal(Person):
  def __init__(self,name, age, office:str, year_of_experience:int):
    super().__init__(name, age)
    self.office:str = office
    self.year_of_experience:int = year_of_experience

  def manage(self):
    print(f"{self.name} is managing the school")

  def announce_holiday(self):
    print("Tommorow is holiday")
  def introduction(self):
    print(f"Hi, I am {self.name}")
    print(f"I am managing this School")


